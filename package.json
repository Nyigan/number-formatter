{
  "name": "@towett/number-formatter",
  "version": "1.3.0",
  "description": "Format and parse numbers: thousands separators, currency, percent, compact, ranges and bytes. Locale-aware, dependency-free",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "cover": "c8 --check-coverage --lines 100 --branches 100 --functions 100 node --test",
    "prepublishOnly": "node scripts/check-placeholders.js && npm run check:lock && npm test && npm run test:types && npm run check:size",
    "test:types": "tsc -p types-test/tsconfig.json",
    "check:lock": "node scripts/check-lock.js",
    "check:size": "node scripts/check-size.js",
    "check:speed": "node scripts/check-speed.js",
    "test:browser:install": "npm install --prefix browser-test && npx --prefix browser-test playwright install --with-deps chromium",
    "test:browser": "node browser-test/run.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nyigan/number-formatter.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "bytes",
    "comma",
    "compact",
    "currency",
    "format",
    "formatter",
    "intl",
    "locale",
    "number",
    "parse",
    "percent",
    "separator",
    "thousands"
  ],
  "author": "Franklin Towett <http://towett.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Nyigan/number-formatter/issues"
  },
  "homepage": "https://github.com/Nyigan/number-formatter#readme",
  "funding": {
    "type": "individual",
    "url": "https://www.etsy.com/shop/FrankForgeCo"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "typescript": "^7.0.2"
  }
}
